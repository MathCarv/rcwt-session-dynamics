* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.svg text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Historical and R1 evidence hashes bind original bytes, including line endings.
# Never normalize these files while adding or checking out the public archive.
/src/*.py -text
/tools/*.py -text
/tools/*.ps1 -text
/docs/rcwt_*.md -text
/docs/rcwt_agent_runtime.json -text
/results/agent*/** -text
